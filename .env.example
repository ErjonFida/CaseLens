# Copy this file to '.env' and fill in your details
GEMINI_API_KEY=your_gemini_api_key_here
JWT_SECRET=change_me_to_a_random_secret


EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
# The width the model is asked for. The column accepts any width; chunks are
# tagged with their model and a query only searches its own. Matryoshka
# models (qwen3-embedding) can be truncated below native size, at some cost.
EMBEDDING_DIMENSIONS=768

LLM_PROVIDER=gemini
# Leave blank to default per provider: gemini-1.5-flash, or gemma4:e4b for ollama. Must match a tag from `ollama list`.
LLM_MODEL=
# Context window for ollama, in tokens. Retrieved chunks sit at the front of
# the prompt, so if this is too small they are what gets silently dropped.
LLM_NUM_CTX=8192

# Reverse proxies allowed to set the client IP via X-Forwarded-For, comma
# separated. Leave empty when clients connect directly. Set it when deploying
# behind nginx/Caddy/a load balancer, or every request rate-limits as the proxy.
TRUSTED_PROXIES=

# SMTP Settings for registration and unknown device alert emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_SENDER=your_email@gmail.com
